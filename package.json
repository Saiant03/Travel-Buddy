{
  "name": "travel-buddy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "build": "vite build",
    "build:probe": "vite build --config probes/offline/vite.config.ts",
    "preview:probe": "vite preview --config probes/offline/vite.config.ts --host 127.0.0.1 --port 4174 --strictPort",
    "build:server-probe": "vite build --config probes/server-console/vite.config.ts",
    "preview:server-probe": "vite preview --config probes/server-console/vite.config.ts --host 127.0.0.1 --port 4175 --strictPort"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^16.5.0",
    "jose": "^6.2.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  }
}
